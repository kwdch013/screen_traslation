<Project>
  <!-- クライアント全体の版の正本。リリース時は dotnet publish の -p:Version=... で上書きする -->
  <PropertyGroup>
    <Version>1.0.0</Version>
    <!-- コミットSHAを版へ連結しない (配布物の版表示を manifest と一致させる) -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
