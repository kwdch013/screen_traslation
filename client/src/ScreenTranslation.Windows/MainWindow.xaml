<Window x:Class="ScreenTranslation.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Screen Translation" Height="860" Width="600"
        MinHeight="700" MinWidth="560"
        xmlns:views="clr-namespace:ScreenTranslation.Windows.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" FontSize="20" FontWeight="SemiBold"
                   Text="接続設定" Margin="0,0,0,16" />
        <TextBlock Grid.Row="1" Text="サーバー HTTPS URL" Margin="0,0,0,4" />
        <TextBox x:Name="ServerUriInput" Grid.Row="2" MinHeight="30" Padding="6" />
        <TextBlock Grid.Row="3" Text="サーバー証明書 SHA-256 指紋 (任意)" Margin="0,14,0,4" />
        <TextBox x:Name="CertificateFingerprintInput" Grid.Row="4" MinHeight="30" Padding="6" />
        <CheckBox x:Name="OverlayEnabledInput" Grid.Row="5" Content="字幕の重畳表示を有効にする"
                  Margin="0,14,0,0" IsChecked="True" />
        <StackPanel Grid.Row="6" Margin="0,10,0,0">
            <CheckBox x:Name="HotkeyEnabledInput" Content="ホットキーを有効にする (他のアプリと競合する場合は無効のままボタンで操作できます)" />
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="開始/停止" VerticalAlignment="Center" />
                <TextBox x:Name="StartStopHotkeyInput" Width="130" Margin="8,0,16,0" Padding="4"
                         AutomationProperties.Name="開始と停止のホットキー" />
                <TextBlock Text="領域を再選択" VerticalAlignment="Center" />
                <TextBox x:Name="ReselectHotkeyInput" Width="130" Margin="8,0,0,0" Padding="4"
                         AutomationProperties.Name="領域再選択のホットキー" />
            </StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="7" Orientation="Horizontal" Margin="0,18,0,0">
            <Button Content="設定を保存" MinWidth="100" Padding="8,5" Click="SaveSettings_Click" />
            <Button Content="取消" MinWidth="80" Padding="8,5" Margin="8,0,0,0" Click="CancelSettings_Click" />
        </StackPanel>
        <StackPanel Grid.Row="8" VerticalAlignment="Top" Margin="0,18,0,0">
            <TextBlock Text="端末資格情報 (通常設定とは別にWindowsで保護して保存)" Margin="0,0,0,4" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="資格情報を保存" Padding="8,5" Margin="8,0,0,0"
                        Click="SaveCredential_Click" />
                <PasswordBox x:Name="CredentialInput" MinHeight="30" Padding="6" />
            </DockPanel>
            <TextBlock x:Name="StatusText" Margin="0,12,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <views:OperationPanel x:Name="Operations" Grid.Row="9" Margin="0,18,0,0" />
    </Grid>
    </ScrollViewer>
</Window>
