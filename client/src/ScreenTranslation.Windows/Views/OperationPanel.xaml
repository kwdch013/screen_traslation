<UserControl x:Class="ScreenTranslation.Windows.Views.OperationPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="操作" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="状態: " />
            <TextBlock x:Name="PhaseText" FontWeight="SemiBold" Text="未接続" />
        </StackPanel>
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,4,0,0"
                   AutomationProperties.LiveSetting="Polite" />
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="ConnectButton" Content="接続" MinWidth="70" Padding="8,4" Click="Connect_Click" />
            <Button x:Name="StartButton" Content="開始" MinWidth="70" Padding="8,4" Margin="8,0,0,0" Click="Start_Click" />
            <Button x:Name="StopButton" Content="停止" MinWidth="70" Padding="8,4" Margin="8,0,0,0" Click="Stop_Click" />
            <Button x:Name="ReselectButton" Content="領域を再選択" MinWidth="100" Padding="8,4" Margin="8,0,0,0" Click="Reselect_Click" />
        </StackPanel>
        <DockPanel Margin="0,10,0,0">
            <Button x:Name="RefreshTargetsButton" DockPanel.Dock="Right" Content="一覧を更新" Padding="8,4" Margin="8,0,0,0" Click="RefreshTargets_Click" />
            <ComboBox x:Name="TargetInput" MinHeight="28" DisplayMemberPath="Name" SelectionChanged="Target_SelectionChanged"
                      AutomationProperties.Name="翻訳する画面またはウィンドウ" />
        </DockPanel>
        <TextBlock x:Name="HotkeyText" TextWrapping="Wrap" Margin="0,10,0,0" />
        <Button x:Name="HotkeyButton" Content="ホットキーを再登録" HorizontalAlignment="Left" Padding="8,4" Margin="0,4,0,0" Click="Hotkey_Click" />
        <TextBlock x:Name="HistoryHeader" Text="字幕履歴 (最新100件・停止後も閲覧できます)" Margin="0,12,0,4" />
        <ListBox x:Name="HistoryList" Height="150" AutomationProperties.Name="字幕履歴" />
    </StackPanel>
</UserControl>
