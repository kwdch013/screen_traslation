FROM mcr.microsoft.com/dotnet/runtime:10.0.14 AS runtime

FROM mcr.microsoft.com/dotnet/sdk:10.0.402
COPY --from=runtime /usr/share/dotnet/shared/Microsoft.NETCore.App/10.0.14 /usr/share/dotnet/shared/Microsoft.NETCore.App/10.0.14

WORKDIR /workspace
COPY . .

RUN dotnet build client/src/ScreenTranslation.Core/ScreenTranslation.Core.csproj --configuration Release \
    && dotnet build client/src/ScreenTranslation.Client/ScreenTranslation.Client.csproj --configuration Release \
    && dotnet build client/tests/ScreenTranslation.Client.IntegrationTests/ScreenTranslation.Client.IntegrationTests.csproj --configuration Release \
    && dotnet test client/tests/ScreenTranslation.Core.Tests/ScreenTranslation.Core.Tests.csproj --configuration Release \
    && dotnet test client/tests/ScreenTranslation.Client.Tests/ScreenTranslation.Client.Tests.csproj --configuration Release \
    && dotnet test client/tests/ScreenTranslation.Client.IntegrationTests/ScreenTranslation.Client.IntegrationTests.csproj --configuration Release --filter "Category=ConnectionIntegration|Category=CaptureSendIntegration"

CMD ["dotnet", "test", "client/tests/ScreenTranslation.Core.Tests/ScreenTranslation.Core.Tests.csproj", "--configuration", "Release"]
