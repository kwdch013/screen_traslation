# コピーして server/.env を作る。秘密の値(トークン・秘密鍵)は書かない。
# 特定のホスト名・IPは雛形に固定しない。環境に合わせて設定する。

# 公開するホスト側アドレス。既定はloopbackのみ。LANへ公開するときだけ、公開するNICのアドレスを指定する。
SERVER_BIND_ADDRESS=127.0.0.1
# ホスト側の待受ポート(コンテナ内は8443固定)。
SERVER_API_PORT=8443

# クライアントが接続に使う「名前:ポート」(Hostヘッダーと同じ形式。カンマ区切りで複数可)。必須。
# 先頭の名前がhealthcheckの証明書検証にも使われるため、証明書のSANに含めること。
SERVER_ALLOWED_HOSTS=

# ブラウザ等のOriginを許可するとき(https://名前:ポート 形式、カンマ区切り)。通常は空。
SERVER_ALLOWED_ORIGINS=

# TLSの読み取り専用ディレクトリ。current/fullchain.pem と current/private-key.pem を含める。必須。
SERVER_TLS_DIR=

# 配布済みのイメージを使うときに上書きする。
# SERVER_IMAGE=screen-translation-server:local
