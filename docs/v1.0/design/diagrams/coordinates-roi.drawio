        <mxCell id="label100" value="モニター A ・ 100% / 96 DPI&#xa;物理原点 (-1920, 0)" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="95" y="145" width="390" height="54" as="geometry"/></mxCell>
        <mxCell id="roi100" value="許可ROI（半開区間）&#xa;[-1800, 100, -1200, 500)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="155" y="230" width="250" height="85" as="geometry"/></mxCell>
